# threading + futures demo: spawn/join, a mutex-guarded shared counter,
# and an ordered parallel map. No link flags needed on either platform.

import * from "stdlib"
import * from "stdlib/threading"
import * from "stdlib/futures"

def w_double(x: int) -> int:
    return x * 2

def w_inc(p: int) -> int:
    m = Mutex(handle=load_i64(p), err=0)
    i = 0
    while i < 1000:
        mutex_lock(m)
        c = load_i64(p + 8)
        store_i64(p + 8, c + 1)
        mutex_unlock(m)
        i = i + 1
    return 0

def main() -> int:
    t = thread_spawn(w_double, 21)
    t = thread_join(t)
    print("spawn/join:", t.result)
    mu = mutex_new()
    block = malloc(16)
    store_i64(block, mu.handle)
    store_i64(block + 8, 0)
    ts = vec_new()
    i = 0
    while i < 4:
        t = thread_spawn(w_inc, block)
        ts = vec_push(ts, t.handle)
        i = i + 1
    i = 0
    while i < 4:
        t = Thread(handle=vec_get(ts, i), err=0, result=0, joined=0)
        t = thread_join(t)
        i = i + 1
    print("counter:", load_i64(block + 8))
    mutex_free(mu)
    free(block)
    args = vec_new()
    i = 1
    while i <= 5:
        args = vec_push(args, i)
        i = i + 1
    r = fut_parallel(w_double, args)
    print("parallel errors:", r.errors)
    i = 0
    while i < vec_len(r.values):
        print(" ", vec_get(r.values, i))
        i = i + 1
    fu = fut_submit(w_double, 50)
    print("future:", fut_result(fu))
    print("DONE")
    return 0