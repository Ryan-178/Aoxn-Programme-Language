# argparse — command-line option parsing (roadmap §2 #25, degraded form).
#
# Python's argparse is class/namespace based; Aoxn has neither, so this is a
# flat, explicit API over a spec table and a `dict[string]` result:
#
#   ap_new(prog, desc)                       -> ArgParser
#   ap_opt(ap, name, short, default, help)   -> ArgParser   (value option)
#   ap_flag(ap, name, short, help)           -> ArgParser   (store-true flag)
#   ap_pos(ap, name, required, help)         -> ArgParser   (positional)
#   ap_parse(ap, args: Vec)                  -> ArgResult
#   ap_help(ap)                              -> string
#   ap_get(res, name, dflt)                  -> string     (guarded read)
#   ap_to_int(s, dflt)                       -> int        (manual digits)
#
# Supported spellings: `--name value`, `--name=value`, `-n value`, `-nvalue`,
# `--` (end of options), `-h` / `--help` (sets res.help_requested; the caller
# prints ap_help). Flags answer "1"/"0". Unknown options, missing values,
# missing required arguments and surplus positionals are VALUE errors
# (res.err != ""), never raises — inspect, then exit.
#
# NOT supported: subparsers, nargs/append actions, type= callbacks, mutually
# exclusive groups, abbreviation of long names. The result is a string map;
# convert with ap_to_int / to_float yourself.
#
# Dependencies: stdlib core (Vec, StrBuf, dict). Uses v0.40.0 dict[V] (heap
# handle) — covered by the selfhost front end, so this module stays
# selfhost-compilable. No externs, no -l flags.

import * from "stdlib"

struct ArgParser:
    prog: string
    desc: string
    names: Vec
    shorts: Vec
    kinds: Vec
    reqs: Vec
    defs: Vec
    helps: Vec
    n: int

struct ArgResult:
    err: string
    values: dict[string]
    help_requested: int

def ap_new(prog: string, desc: string) -> ArgParser:
    return ArgParser(prog=prog, desc=desc, names=vec_new(), shorts=vec_new(), kinds=vec_new(), reqs=vec_new(), defs=vec_new(), helps=vec_new(), n=0)

def ap_add(ap: ArgParser, name: string, short: string, kind: int, required: int, default: string, help: string) -> ArgParser:
    ap.names = vec_push_str(ap.names, name)
    ap.shorts = vec_push_str(ap.shorts, short)
    ap.kinds = vec_push(ap.kinds, kind)
    ap.reqs = vec_push(ap.reqs, required)
    ap.defs = vec_push_str(ap.defs, default)
    ap.helps = vec_push_str(ap.helps, help)
    ap.n = ap.n + 1
    return ap

def ap_opt(ap: ArgParser, name: string, short: string, default: string, help: string) -> ArgParser:
    return ap_add(ap, name, short, 0, 0, default, help)

def ap_flag(ap: ArgParser, name: string, short: string, help: string) -> ArgParser:
    return ap_add(ap, name, short, 1, 0, "0", help)

def ap_pos(ap: ArgParser, name: string, required: int, help: string) -> ArgParser:
    return ap_add(ap, name, "", 2, required, "", help)

def ap_find(ap: ArgParser, name: string) -> int:
    i = 0
    while i < ap.n:
        if vec_get(ap.kinds, i) != 2:
            if vec_get_str(ap.names, i) == name:
                return i
        i = i + 1
    return -1

def ap_find_short(ap: ArgParser, short: string) -> int:
    i = 0
    while i < ap.n:
        if vec_get(ap.kinds, i) != 2:
            if vec_get_str(ap.shorts, i) == short:
                return i
        i = i + 1
    return -1

def ap_positional_at(ap: ArgParser, pos: int) -> int:
    seen = 0
    i = 0
    while i < ap.n:
        if vec_get(ap.kinds, i) == 2:
            if seen == pos:
                return i
            seen = seen + 1
        i = i + 1
    return -1

def ap_parse(ap: ArgParser, args: Vec) -> ArgResult:
    values: dict[string] = {}
    i = 0
    while i < ap.n:
        if vec_get(ap.reqs, i) == 0:
            values[vec_get_str(ap.names, i)] = vec_get_str(ap.defs, i)
        i = i + 1
    res = ArgResult(err="", values=values, help_requested=0)
    pos = 0
    end_of_opts = 0
    i = 0
    n = vec_len(args)
    while i < n:
        a = vec_get_str(args, i)
        alen = len(a)
        if end_of_opts == 1:
            idx = ap_positional_at(ap, pos)
            if idx < 0:
                res.err = "unexpected positional argument: " + a
                return res
            values[vec_get_str(ap.names, idx)] = a
            pos = pos + 1
        elif a == "--":
            end_of_opts = 1
        elif a == "-h" or a == "--help":
            res.help_requested = 1
        elif alen > 2 and str_sub(a, 0, 2) == "--":
            body = str_sub(a, 2, alen)
            blen = len(body)
            eq = -1
            j = 0
            while j < blen:
                if load_u8(body, j) == 61:
                    eq = j
                    j = blen
                else:
                    j = j + 1
            name = body
            inline = ""
            has_inline = 0
            if eq >= 0:
                name = str_sub(body, 0, eq)
                inline = str_sub(body, eq + 1, blen)
                has_inline = 1
            idx = ap_find(ap, name)
            if idx < 0:
                res.err = "unrecognized argument: --" + name
                return res
            if vec_get(ap.kinds, idx) == 1:
                if has_inline == 1:
                    res.err = "flag --" + name + " takes no value"
                    return res
                values[name] = "1"
            else:
                if has_inline == 1:
                    values[name] = inline
                else:
                    if i + 1 >= n:
                        res.err = "option --" + name + " requires a value"
                        return res
                    i = i + 1
                    values[name] = vec_get_str(args, i)
        elif alen > 1 and load_u8(a, 0) == 45:
            short = str_sub(a, 1, 2)
            idx = ap_find_short(ap, short)
            if idx < 0:
                res.err = "unrecognized argument: -" + short
                return res
            name = vec_get_str(ap.names, idx)
            if vec_get(ap.kinds, idx) == 1:
                if alen > 2:
                    res.err = "flag -" + short + " takes no value"
                    return res
                values[name] = "1"
            else:
                if alen > 2:
                    values[name] = str_sub(a, 2, alen)
                else:
                    if i + 1 >= n:
                        res.err = "option -" + short + " requires a value"
                        return res
                    i = i + 1
                    values[name] = vec_get_str(args, i)
        else:
            idx = ap_positional_at(ap, pos)
            if idx < 0:
                res.err = "unexpected positional argument: " + a
                return res
            values[vec_get_str(ap.names, idx)] = a
            pos = pos + 1
        i = i + 1
    if res.help_requested == 1:
        return res
    i = 0
    while i < ap.n:
        if vec_get(ap.reqs, i) == 1:
            name = vec_get_str(ap.names, i)
            if not dict_has(values, name):
                res.err = "missing required argument: " + name
                return res
        i = i + 1
    return res

def ap_get(res: ArgResult, name: string, dflt: string) -> string:
    if dict_has(res.values, name):
        return res.values[name]
    return dflt

def ap_to_int(s: string, dflt: int) -> int:
    n = len(s)
    if n == 0:
        return dflt
    i = 0
    neg = 0
    if load_u8(s, 0) == 45:
        neg = 1
        i = 1
    if i == n:
        return dflt
    v = 0
    while i < n:
        c = load_u8(s, i)
        if c < 48 or c > 57:
            return dflt
        v = v * 10 + (c - 48)
        i = i + 1
    if neg == 1:
        v = 0 - v
    return v

def ap_help(ap: ArgParser) -> string:
    w = sb_new(256)
    w = sb_str(w, "usage: ")
    w = sb_str(w, ap.prog)
    w = sb_str(w, " [-h]")
    i = 0
    while i < ap.n:
        kind = vec_get(ap.kinds, i)
        name = vec_get_str(ap.names, i)
        if kind == 0:
            w = sb_str(w, " [--" + name + " " + name + "]")
        elif kind == 1:
            w = sb_str(w, " [--" + name + "]")
        i = i + 1
    i = 0
    while i < ap.n:
        if vec_get(ap.kinds, i) == 2:
            name = vec_get_str(ap.names, i)
            if vec_get(ap.reqs, i) == 1:
                w = sb_str(w, " " + name)
            else:
                w = sb_str(w, " [" + name + "]")
        i = i + 1
    w = sb_byte(w, 10)
    w = sb_byte(w, 10)
    w = sb_str(w, ap.desc)
    w = sb_byte(w, 10)
    w = sb_byte(w, 10)
    i = 0
    while i < ap.n:
        kind = vec_get(ap.kinds, i)
        name = vec_get_str(ap.names, i)
        if kind == 2:
            w = sb_str(w, "  " + name)
        else:
            short = vec_get_str(ap.shorts, i)
            if short != "":
                w = sb_str(w, "  -" + short + ", ")
            else:
                w = sb_str(w, "      ")
            w = sb_str(w, "--" + name)
            if kind == 0:
                w = sb_str(w, " " + name)
        w = sb_str(w, "    ")
        w = sb_str(w, vec_get_str(ap.helps, i))
        if kind == 0:
            d = vec_get_str(ap.defs, i)
            if d != "":
                w = sb_str(w, " (default: " + d + ")")
        w = sb_byte(w, 10)
        i = i + 1
    return sb_text(w)